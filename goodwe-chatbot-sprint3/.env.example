# Copie para .env (o .env NUNCA vai para o Git — está no .gitignore)
GROQ_API_KEY=gsk_sua_chave_aqui

# Pausa antes de cada chamada do agente (segundos) — rate limit do tier gratuito do Groq
AGENT_SLEEP_S=15
# Pausa entre avaliações do juiz (segundos)
EVAL_JUDGE_SLEEP_S=6
# Modelo usado como juiz (LLM as a judge) — auto = escolhe um disponível na conta
JUDGE_MODEL=auto
